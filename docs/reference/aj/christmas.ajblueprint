				"d4ea7211-6231-4f60-99e2-1a2f2a342fac": {
					"name": "waist1",
					"type": "bone",
					"rotation_global": false,
					"quaternion_interpolation": false,
					"keyframes": [
						{
							"channel": "rotation",
							"data_points": [
								{
