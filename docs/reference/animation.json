{
  "type": "animation",
  "schema_version": 5,
  "id": "example:ir_design",
  "target_minecraft_version": "26.3",
  "metadata": {
    "name": "Animation v5 Design Example",
    "description": "Design proposal only; not loadable by the current v4 runtime.",
    "license": "Apache-2.0"
  },
  "settings": {
    "standalone": true,
    "cooldown": 0,
    "rotation_deadzone": 50,
    "display_interpolation_ticks": 1,
    "player": {
      "hidden": false,
      "stop_conditions": {
        "movement_distance": 0.3,
        "jump": true,
        "submerge": true,
        "ride": true,
        "damage": true,
        "attack": true,
        "game_mode_change": true
      }
    }
  },
  "nodes": {
    "root": {
      "name": "root",
      "transform": [
        { "id": "size", "op": "scale", "value": [1, 1, 1] }
      ]
    },
    "n1": {
      "name": "arm",
      "parent": "root",
      "transform": [
        { "id": "position", "op": "translate", "value": [0, 1.5, 0] },
        { "id": "spin", "op": "rotate_euler", "order": "XYZ", "value": [0, 0, 0] }
      ],
      "attachments": {
        "prop": {
          "type": "item_display",
          "item_stack_snbt": "{id:\"minecraft:paper\",count:1}",
          "item_display": "fixed"
        }
      }
    },
    "n2": {
      "name": "arm_x",
      "parent": "n1",
      "inherit": { "rotation": "parent", "scale": false, "visibility": true },
      "transform": [
        { "id": "offset", "op": "translate", "value": [0, 0.5, 0] }
      ]
    },
    "n3": {
      "name": "unknown_accessory",
      "parent": "n2",
      "source": { "format": "example", "node_id": "original-accessory" },
      "attachments": {
        "custom": { "type": "external", "key": "example:accessory", "data": { "name": "accessory" } }
      }
    }
  },
  "animation": {
    "duration": 2,
    "clock": { "type": "molang", "expression": "q.anim_time + q.delta_time * v.speed" },
    "playback": { "mode": "loop", "loop_start": 0, "start_delay": 0, "loop_delay": 0 },
    "programs": { "initialize": "v.speed = 1;" },
    "tracks": [
      {
        "target": { "node": "n1", "operation": "spin" },
        "channel": "value",
        "driver": {
          "type": "curve",
          "keys": [
            { "time": 0, "value": [0, 0, 0] },
            { "time": 2, "value": [0, 720, 0] }
          ],
          "segments": [
            { "interpolation": "linear", "easing": { "kernel": "power", "direction": "in_out", "exponent": 2 } }
          ]
        }
      },
      {
        "target": { "node": "n1", "operation": "position" },
        "channel": "value",
        "driver": {
          "type": "curve",
          "keys": [
            { "time": 0, "value": [0, 1.5, { "molang": "math.sin(q.anim_time * 180) * 0.1" }] },
            { "time": 0.01, "value": [0.1, 1.5, 0] },
            { "time": 2, "value": [0, 1.5, 0] }
          ],
          "segments": [
            { "interpolation": "linear" },
            {
              "interpolation": "bezier",
              "handles": [
                { "out": { "time": 0.3, "value": 0.4 }, "in": { "time": 0.7, "value": 0.2 } },
                { "out": { "time": 0.3, "value": 1.8 }, "in": { "time": 0.7, "value": 1.8 } },
                { "out": { "time": 0.3, "value": { "molang": "math.sin(q.anim_time * 180) * 0.1" } }, "in": { "time": 0.7, "value": 0 } }
              ],
              "easing": { "kernel": "sine", "direction": "in_out" }
            }
          ]
        }
      },
      {
        "target": { "node": "root" },
        "channel": "visible",
        "driver": { "type": "state", "keys": [ { "time": 0, "value": true }, { "time": 1.9, "value": false } ] }
      },
      {
        "target": { "node": "n1", "attachment": "prop" },
        "channel": "nbt",
        "driver": {
          "type": "state",
          "keys": [
            { "time": 0, "value": { "merge": "{glowing:1b}", "remove": [] } },
            { "time": 1, "value": { "merge": "{}", "remove": ["glowing"] } }
          ]
        }
      }
    ],
    "events": {
      "timeline": [
        {
          "time": 0.01,
          "direction": "forward",
          "source": { "type": "server" },
          "origin": { "type": "node", "node": "n2", "offset": [0, 0, 0] },
          "action": { "type": "commands", "commands": ["particle minecraft:end_rod ~ ~ ~ 0 0 0 0 1"] }
        }
      ]
    }
  }
}
