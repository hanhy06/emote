{
  "type": "animation",
  "schema_version": 5,
  "id": "example:animation",
  "target_minecraft_version": "26.3",
  "metadata": {
    "name": "Animation Format Reference",
    "description": "A rotating display with curves, Molang, visibility, NBT patches, and a command event.",
    "license": "Apache-2.0"
  },
  "settings": {
    "standalone": true,
    "cooldown": "0t",
    "rotation_deadzone": 50,
    "player": {
      "hidden": false,
      "stop_conditions": {
        "movement_distance": 0.3,
        "jump": true,
        "submerge": true,
        "ride": true,
        "damage": true,
        "attack": true,
        "game_mode_change": true
      }
    }
  },
  "callbacks": [],
  "nodes": {
    "root": {
      "name": "root",
      "transform": [
        { "id": "size", "op": "scale", "value": [1, 1, 1] }
      ]
    },
    "n1": {
      "name": "arm",
      "parent": "root",
      "transform": [
        { "id": "position", "op": "translate", "value": [0, 1.5, 0] },
        { "id": "spin", "op": "rotate_euler", "order": "XYZ", "value": [0, 0, 0] }
      ],
      "attachments": {
        "prop": {
          "type": "item_display",
          "item_stack_snbt": "{id:\"minecraft:paper\",count:1}",
          "item_display": "fixed"
        }
      }
    },
    "n2": {
      "name": "arm_x",
      "parent": "n1",
      "inherit": { "rotation": "parent", "scale": false, "visibility": true },
      "transform": [
        { "id": "offset", "op": "translate", "value": [0, 0.5, 0] }
      ]
    }
  },
  "animation": {
    "duration": "2s",
    "clock": { "type": "molang", "expression": "q.anim_time + q.delta_time * v.speed" },
    "playback": { "mode": "loop", "loop_start": "0t", "start_delay": "0t", "loop_delay": "0t" },
    "molang": {
      "initialize": "v.speed = 1; v.phase = 0;",
      "tick": "v.phase = v.phase + q.delta_time * v.speed;"
    },
    "tracks": [
      {
        "target": { "node": "n1", "operation": "spin" },
        "channel": "value",
        "driver": {
          "type": "curve",
          "keys": [
            { "time": "0t", "value": [0, 0, 0] },
            { "time": "2s", "value": [0, 720, 0] }
          ],
          "segments": [
            { "interpolation": "linear", "easing": { "kernel": "power", "direction": "in_out", "exponent": 2 } }
          ]
        }
      },
      {
        "target": { "node": "n1", "operation": "position" },
        "channel": "value",
        "driver": {
          "type": "curve",
          "keys": [
            { "time": "0t", "value": [0, 1.5, { "molang": "math.sin(v.phase * 180) * 0.1" }] },
            { "time": "10t", "pre": [0.1, 1.5, 0], "post": [0.2, 1.5, 0] },
            { "time": "2s", "value": [0, 1.5, 0] }
          ],
          "segments": [
            { "interpolation": "linear" },
            {
              "interpolation": "bezier",
              "handles": [
                { "out": { "time": 0.3, "value": 0.4 }, "in": { "time": 0.7, "value": 0.2 } },
                { "out": { "time": 0.3, "value": 1.8 }, "in": { "time": 0.7, "value": 1.8 } },
                { "out": { "time": 0.3, "value": { "molang": "math.sin(v.phase * 180) * 0.1" } }, "in": { "time": 0.7, "value": 0 } }
              ],
              "easing": { "kernel": "sine", "direction": "in_out" }
            }
          ]
        }
      },
      {
        "target": { "node": "n1", "attachment": "prop" },
        "channel": "visible",
        "driver": { "type": "state", "keys": [ { "time": "0t", "value": true }, { "time": "38t", "value": false } ] }
      },
      {
        "target": { "node": "n1", "attachment": "prop" },
        "channel": "nbt",
        "driver": {
          "type": "state",
          "keys": [
            { "time": "0t", "value": { "merge": "{glowing:1b}", "remove": [] } },
            { "time": "1s", "value": { "merge": "{}", "remove": ["glowing"] } }
          ]
        }
      }
    ],
    "events": {
      "start": [],
      "timeline": [
        {
          "time": "10t",
          "direction": "forward",
          "source": { "type": "node", "node": "n1", "attachment": "prop" },
          "origin": { "type": "node", "node": "n2", "offset": [0, 0, 0], "rotation": "origin" },
          "action": { "type": "commands", "commands": ["particle minecraft:end_rod ~ ~ ~ 0 0 0 0 1"] }
        }
      ],
      "loop": [],
      "stop": []
    }
  }
}
