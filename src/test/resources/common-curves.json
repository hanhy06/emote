    "b": { "transform": [{ "id": "scale", "op": "scale", "value": [1, 1, 1] }] },
    "c": { "transform": [{ "id": "position", "op": "translate", "value": [0, 0, 0] }] },
    "s": { "transform": [{ "id": "position", "op": "translate", "value": [0, 0, 0] }] },
