            { "time": "30t", "value": [{ "molang": "q.value('random', 0)" }, 10, { "molang": "q.value('bend', 0) + q.key_frame_lerp_time" }] }
          ],
          "segments": [{ "interpolation": "linear", "easing": { "kernel": "power", "direction": "in", "exponent": { "molang": "q.scoreboard('power')" } }, "previous": [{ "molang": "q.scoreboard('unused')" }, 0, 0] }]
        }
      },
      {
        "target": { "node": "b", "operation": "scale" }, "channel": "value",
        "driver": {
          "type": "curve", "keys": [{ "time": "0t", "value": [0, 0, 0] }, { "time": "40t", "value": [8, 8, 8] }],
          "segments": [{ "interpolation": "bezier", "handles": [
            { "out": { "time": { "molang": "q.scoreboard('out_time')" }, "value": 2 }, "in": { "time": { "molang": "q.scoreboard('in_time')" }, "value": 6 } },
            { "out": { "time": { "molang": "q.scoreboard('out_time')" }, "value": 2 }, "in": { "time": { "molang": "q.scoreboard('in_time')" }, "value": 6 } },
            { "out": { "time": { "molang": "q.scoreboard('out_time')" }, "value": 2 }, "in": { "time": { "molang": "q.scoreboard('in_time')" }, "value": 6 } }
          ] }]
