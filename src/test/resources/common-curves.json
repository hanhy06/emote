      "independent": { "base": [0], "type": "expression", "value": [{ "molang": "q.scoreboard('random') + math.random(0.1, 0.9)" }] },
      "bend": { "base": [0], "type": "curve", "keys": [{ "time": "0t", "value": [0] }, { "time": "40t", "value": [4] }], "segments": [{ "interpolation": "linear" }] }
    },
    "tracks": [
      { "target": { "node": "z", "operation": "position" }, "channel": "value", "blend": { "base": [0, 0, 2], "weight": { "molang": "q.value('weight', 0)" } }, "driver": { "type": "expression", "value": [{ "molang": "q.value('random', 0)" }, { "molang": "q.scoreboard('order')" }, 1] } },
      { "target": { "node": "a", "operation": "shift" }, "channel": "value", "driver": { "type": "expression", "value": [0, { "molang": "q.scoreboard('order')" }, 0] } },
