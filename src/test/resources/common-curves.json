{
  "type": "animation", "schema_version": 5, "target_minecraft_version": "26.2", "id": "test:common_curves",
  "metadata": { "name": "Common curves", "description": "", "author": "test", "license": "Apache-2.0" },
  "settings": { "standalone": true, "cooldown": "0t", "rotation_deadzone": 50, "player": { "hidden": true, "stop_conditions": { "movement_distance": 0.3, "jump": true, "submerge": true, "ride": true, "damage": true, "attack": true, "game_mode_change": true } } },
  "nodes": {
