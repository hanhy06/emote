      { "target": { "node": "c", "operation": "position" }, "channel": "value", "driver": { "type": "expression", "value": [{ "molang": "q.value('independent', 0)" }, 0, 0] } },
      { "target": { "node": "s", "operation": "position" }, "channel": "value", "driver": { "type": "curve", "keys": [{ "time": "0t", "value": [1, 0, 0] }, { "time": "40t", "value": [{ "molang": "q.scoreboard('unused')" }, 0, 0] }], "segments": [{ "interpolation": "step", "out_tangent": [{ "molang": "q.scoreboard('unused')" }, 0, 0] }] } }
