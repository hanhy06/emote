{
    "schemaVersion": 1,
    "id": "emote",
    "version": "${version}",
    "name": "emote",
    "description": "full server side emote player",
    "authors": [
        "hanhy06"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/emote",
        "sources": "https://github.com/hanhy06/emote"
    },
    "license": "Apache-2.0",
    "icon": "assets/emote/icon.png",
